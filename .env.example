# Copy to .env. All backend settings use the DSS_ prefix.
DSS_DATA_MODE=demo            # demo = synthetic placeholder layers; raster = real GeoTIFF/PostGIS layers
DSS_DATABASE_URL=postgresql+psycopg://dss:dss@db:5432/dss
DSS_REDIS_URL=redis://redis:6379/0
DSS_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Frontend (read at build time by Vite). Public Mapbox token (pk.…); restrict it to your site URLs.
# Without it the viewer falls back to an Esri satellite basemap.
VITE_MAPBOX_TOKEN=

# USGS EROS M2M (remote-sensing ingestion). Put real values in .env (git-ignored), never here.
# Username = your ERS login; token = an M2M application token from
# https://ers.cr.usgs.gov/password/appgenerate (requires M2M access on the account).
DSS_USGS_USERNAME=
DSS_USGS_TOKEN=
